{
  "name": "sdit-bustanul-huda-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit -p tsconfig.server.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:db:setup": "npx prisma migrate deploy --skip-generate && npx tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "jose": "^6.2.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7"
  }
}
